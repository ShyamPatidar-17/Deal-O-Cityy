# Server Configuration
PORT=4000

# Database Configuration
# MongoDB connection string (e.g., MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# Cloudinary Configuration
# Cloudinary account credentials for image uploads
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Authentication Configuration
# JSON Web Token secret key for user authentication sessions
JWT_SECRET=your_jwt_secret_key

# Admin Panel Credentials
# Default login credentials for the admin dashboard
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=secure_admin_password

# Payment Gateways Configuration
# Stripe Secret Key (sk_test_...) for processing card payments
STRIPE_SECRET_KEY=your_stripe_secret_key
